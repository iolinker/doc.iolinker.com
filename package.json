{
  "name": "iolinker-documentation",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "docs:dev": "vitepress dev docs --host 127.0.0.1",
    "docs:build": "node scripts/prepare-content.mjs && npm run check && vitepress build docs && node scripts/site-check.mjs --dist",
    "docs:preview": "vitepress preview docs --host 127.0.0.1",
    "check": "node scripts/site-check.mjs",
    "test:browser": "node --test tests/browser.test.mjs"
  },
  "devDependencies": {
    "playwright": "1.65.1",
    "vitepress": "1.6.4",
    "vue": "3.5.24"
  }
}
